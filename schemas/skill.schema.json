{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-os/schemas/skill.schema.json",
  "title": "AI OS Skill",
  "type": "object",
  "required": ["id", "name", "version", "description", "triggers", "inputs", "outputs", "dependencies", "status", "path"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "description": {"type": "string", "minLength": 1},
    "triggers": {"type": "array", "items": {"type": "string"}},
    "inputs": {"type": "array", "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "status": {"enum": ["draft", "experimental", "stable", "deprecated", "archived"]},
    "path": {"type": "string", "pattern": "^\\.agent/skills/.+/SKILL\\.md$"},
    "replaces": {"type": ["string", "null"]},
    "deprecatedBy": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
